{
  "name": "llmchat",
  "version": "0.1.0",
  "description": "Cross-platform AI chat application with Next.js and desktop runtimes.",
  "author": "zyqfork",
  "main": "electron/main.cjs",
  "private": false,
  "license": "mit",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/ensure-pi-web-ui-exports.mjs && node scripts/ensure-pi-ai-exports.mjs && cross-env BUILD_MODE=standalone next build && node scripts/copy-standalone.js",
    "start": "node scripts/start-prod.js",
    "lint": "eslint . --cache",
    "export": "node scripts/clean-next-cache.mjs && node scripts/ensure-pi-web-ui-exports.mjs && node scripts/ensure-pi-ai-exports.mjs && cross-env BUILD_MODE=export BUILD_APP=1 NEXT_DIST_DIR=dist next build",
    "export:dev": "cross-env BUILD_MODE=export BUILD_APP=1 NODE_OPTIONS=--no-deprecation next dev",
    "export:debug": "node scripts/clean-next-cache.mjs && node scripts/ensure-pi-web-ui-exports.mjs && node scripts/ensure-pi-ai-exports.mjs && cross-env BUILD_MODE=export BUILD_APP=1 DEBUG_BUILD=true NEXT_DIST_DIR=dist next build",
    "app:dev": "yarn tauri dev",
    "app:dev:tauri": "yarn tauri dev",
    "app:dev:electron": "yarn electron:dev",
    "app:build": "yarn tauri build",
    "app:build:tauri": "yarn tauri build",
    "app:build:electron": "yarn electron:build",
    "electron:dev": "concurrently -k \"yarn dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "cross-env BUILD_APP_RUNTIME=electron yarn export && electron-builder",
    "version:sync": "node scripts/sync-version-from-tag.mjs",
    "icons:electron": "node scripts/generate-electron-app-icon.mjs",
    "app:build:debug": "yarn export:debug && yarn tauri build --features debug-devtools",
    "app:clear": "yarn tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "fetch-models": "node ./scripts/fetch-models-config.js",
    "prepare": "husky install",
    "postinstall": "patch-package && node scripts/ensure-pi-web-ui-exports.mjs && node scripts/ensure-pi-ai-exports.mjs",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf yarn dev",
    "test": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@earendil-works/pi-agent-core": "^0.79.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-web-ui": "^0.75.3",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "18.0.1",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "5.10.0",
    "@lobehub/ui": "5.15.15",
    "@mariozechner/mini-lit": "0.2.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@next/third-parties": "16.2.9",
    "@svgr/webpack": "^8.1.0",
    "@uiw/react-json-view": "^2.0.0-alpha.43",
    "@vercel/analytics": "2.0.1",
    "@viz-js/viz": "3.28.0",
    "antd": "6.4.4",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "7.4.2",
    "heic2any": "^0.0.4",
    "html-react-parser": "6.1.3",
    "html-to-image": "^1.11.11",
    "jspdf": "4.2.1",
    "lit": "3.3.3",
    "lodash-es": "^4.17.21",
    "markdown-to-txt": "^2.0.1",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.4.0",
    "micromark": "4.0.2",
    "motion": "12.40.0",
    "nanoid": "^5.0.3",
    "next": "16.2.9",
    "node-fetch": "^3.3.1",
    "plantuml-encoder": "^1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.17.0",
    "react-xml-viewer": "^3.0.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rt-client": "^0.5.1",
    "sass": "1.101.0",
    "sharp": "0.35.1",
    "use-debounce": "10.1.1",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "dmg-builder": "26.15.2",
    "electron": "42.4.0",
    "electron-builder": "^26.15.2",
    "electron-builder-squirrel-windows": "^26.15.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.0.7",
    "patch-package": "^8.0.1",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "wait-on": "9.0.10",
    "webpack": "5.107.2"
  },
  "build": {
    "appId": "com.github.zyqfork.llmchat.electron",
    "productName": "LLMChat",
    "icon": "src-tauri/icons/icon.png",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src-tauri/icons",
        "to": "icons",
        "filter": [
          "icon.ico",
          "icon.png",
          "icon.icns"
        ]
      }
    ],
    "directories": {
      "buildResources": "electron/resources"
    },
    "asar": true,
    "publish": null,
    "artifactName": "${productName}-electron-${version}-${os}-${arch}.${ext}",
    "deb": {
      "packageName": "llmchat-electron"
    },
    "protocols": [
      {
        "name": "LLMChat",
        "schemes": [
          "llmchat"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "zyqfork <zyqfork@users.noreply.github.com>"
    }
  },
  "packageManager": "yarn@1.22.19"
}
