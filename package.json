{
  "name": "llmchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev",
    "build": "cross-env BUILD_MODE=standalone next build && node scripts/copy-standalone.js",
    "start": "node --no-deprecation .next/standalone/server.js",
    "lint": "next lint",
    "export": "cross-env BUILD_MODE=export BUILD_APP=1 NEXT_DIST_DIR=dist next build",
    "export:dev": "cross-env BUILD_MODE=export BUILD_APP=1 NODE_OPTIONS='--no-deprecation' next dev",
    "export:debug": "cross-env BUILD_MODE=export BUILD_APP=1 DEBUG_BUILD=true NEXT_DIST_DIR=dist next build",
    "app:dev": "yarn tauri dev",
    "app:build": "yarn tauri build",
    "app:build:debug": "yarn export:debug && yarn tauri build --features debug-devtools",
    "app:clear": "yarn tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "fetch-models": "node ./scripts/fetch-models-config.js",
    "prepare": "husky install",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf yarn dev",
    "test": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --ci"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.28",
    "@ai-sdk/azure": "^3.0.21",
    "@ai-sdk/google": "^3.0.15",
    "@ai-sdk/openai": "^3.0.21",
    "@ai-sdk/openai-compatible": "^2.0.21",
    "@ai-sdk/xai": "^3.0.39",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@google/genai": "^1.12.0",
    "@hello-pangea/dnd": "^16.5.0",
    "@llm-ui/markdown": "^0.13.3",
    "@llm-ui/react": "^0.13.3",
    "@lobehub/icons": "^2.16.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mswjs/interceptors": "^0.40.0",
    "@next/third-parties": "^14.1.0",
    "@svgr/webpack": "^6.5.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@vercel/analytics": "^0.1.11",
    "ai": "^6.0.57",
    "antd": "^5.26.6",
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "framer-motion": "^12.23.6",
    "fuse.js": "^7.0.0",
